---
import { profile } from "../data/content.js";
const year = new Date().getFullYear();
---

<footer class="border-t border-line px-6 py-6 lg:px-16">
  <div class="mx-auto flex max-w-2xl flex-col items-center justify-between gap-3 text-xs text-ink-faint sm:flex-row">
    <span>© {year} {profile.name}</span>
    <div class="flex items-center gap-4">
      <div class="theme-switch flex items-center gap-1.5 lg:hidden">
        <span>theme:</span>
        <button type="button" data-theme-btn="dark" class="uppercase tracking-wide">dark</button>
        <span>/</span>
        <button type="button" data-theme-btn="light" class="uppercase tracking-wide">light</button>
      </div>
    </div>
  </div>
</footer>
