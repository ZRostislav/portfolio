---
import { skills, achievements, stack } from "../data/content.js";
import Icon from "./Icon.astro";

const groups = [
  { title: "Языки", items: stack.languages },
  { title: "Фреймворки и библиотеки", items: stack.frameworks },
  { title: "Инструменты", items: stack.tools },
];
---

<section id="skills" class="panel px-6 py-16 lg:px-16 lg:py-20">
  <div class="mx-auto max-w-2xl space-y-14">
    <div>
      <h2 class="section-heading text-lg">Навыки</h2>

      <ul class="mt-6 divide-y divide-line border border-line">
        {skills.map((skill) => (
          <li class="flex items-center justify-between gap-3 px-4 py-3 sm:gap-4">
            <span class="shrink-0 text-sm font-medium text-ink">{skill.name}</span>
            <div class="flex items-center gap-3">
              <div class="h-1.5 w-16 overflow-hidden bg-surface-2 sm:w-28">
                <div class="h-full bg-accent" style={`width: ${skill.level}%`}></div>
              </div>
              <span class="w-9 shrink-0 text-right text-xs text-ink-faint">{skill.level}%</span>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="section-heading text-lg">Достижения</h2>

      <ul class="mt-6 divide-y divide-line border border-line">
        {achievements.map((a) => (
          <li class="flex items-start gap-3 px-4 py-3">
            <Icon name="sparkle" class="mt-0.5 h-4 w-4 shrink-0 text-blue" />
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <h4 class="text-sm font-medium text-ink">{a.title}</h4>
                <span class="text-xs text-ink-faint">{a.year}</span>
              </div>
              <p class="mt-1 text-sm text-ink-dim">{a.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="section-heading text-lg">Стек</h2>

      <div class="mt-6 space-y-8">
        {groups.map((group) => (
          <div>
            <h3 class="text-xs uppercase tracking-wide text-ink-faint">{group.title}</h3>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="border border-line bg-surface px-3 py-1.5 text-sm text-ink transition-colors hover:border-accent hover:text-accent">
                  {item}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
