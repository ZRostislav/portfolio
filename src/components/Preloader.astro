---
import { profile } from "../data/content.js";

const bootLines = [
  "booting portfolio.sys",
  `whoami → ${profile.name}`,
  "mounting /sections...",
  "status: ready",
];
---

<div id="preloader" class="fixed inset-0 z-[100] flex items-center justify-center bg-paper">
  <div class="w-[min(88vw,420px)] font-mono text-[13px] leading-relaxed">
    <div id="preloader-lines" class="space-y-1 text-ink-dim"></div>

    <div class="mt-4 flex items-center gap-3">
      <div class="relative h-3 flex-1 overflow-hidden border border-line bg-surface">
        <div id="preloader-bar" class="absolute inset-y-0 left-0 w-0 bg-accent"></div>
      </div>
      <span id="preloader-percent" class="w-10 shrink-0 text-right text-ink-faint">0%</span>
    </div>
  </div>
</div>

<style>
  #preloader-lines .line {
    opacity: 0;
    white-space: pre;
  }
  #preloader-lines .line.is-visible {
    opacity: 1;
  }
  #preloader-lines .line .caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 2px;
    background: var(--color-accent);
    vertical-align: -0.15em;
    animation: caretBlink 0.9s steps(1) infinite;
  }
  @keyframes caretBlink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }
  .glitch {
    animation: glitchShift 0.14s steps(2, end) 2;
  }
  @keyframes glitchShift {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-1px, 1px); }
    50% { transform: translate(1px, 0); text-shadow: -1px 0 var(--color-blue), 1px 0 var(--color-accent); }
    75% { transform: translate(-1px, -1px); }
    100% { transform: translate(0, 0); text-shadow: none; }
  }
  #preloader.is-done {
    animation: preloaderOut 0.4s ease forwards;
  }
  @keyframes preloaderOut {
    0% { opacity: 1; filter: blur(0); }
    100% { opacity: 0; filter: blur(2px); }
  }
</style>

<script define:vars={{ bootLines }}>
  const preloader = document.getElementById("preloader");
  const linesEl = document.getElementById("preloader-lines");
  const bar = document.getElementById("preloader-bar");
  const percentEl = document.getElementById("preloader-percent");

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (prefersReduced || !preloader || !linesEl) {
    preloader?.remove();
  } else {
    // Печатаем строки по одному символу, с редким лёгким глитчем на
    // случайных строках — читается как быстрый boot-лог терминала.
    const CHAR_DELAY = 14;
    const LINE_GAP = 90;
    const MIN_DURATION = 1250;
    const start = performance.now();

    function typeLine(text, container) {
      return new Promise((resolve) => {
        const row = document.createElement("div");
        row.className = "line is-visible";
        const textSpan = document.createElement("span");
        row.appendChild(textSpan);
        const caret = document.createElement("span");
        caret.className = "caret";
        row.appendChild(caret);
        container.appendChild(row);

        let i = 0;
        function step() {
          if (i <= text.length) {
            textSpan.textContent = text.slice(0, i);
            // Редкий микро-глитч на середине строки
            if (i === Math.floor(text.length * 0.6)) {
              row.classList.add("glitch");
              setTimeout(() => row.classList.remove("glitch"), 160);
            }
            i++;
            setTimeout(step, CHAR_DELAY);
          } else {
            caret.remove();
            setTimeout(resolve, LINE_GAP);
          }
        }
        step();
      });
    }

    async function typeAll() {
      for (const line of bootLines) {
        await typeLine(line, linesEl);
      }
    }

    function tickProgress() {
      const elapsed = performance.now() - start;
      const pct = Math.min(100, Math.round((elapsed / MIN_DURATION) * 100));
      if (bar) bar.style.width = `${pct}%`;
      if (percentEl) percentEl.textContent = `${pct}%`;
      if (pct < 100) requestAnimationFrame(tickProgress);
    }

    function finish() {
      preloader.classList.add("is-done");
      setTimeout(() => {
        preloader.remove();
        document.dispatchEvent(new CustomEvent("preloader:done"));
      }, 420);
    }

    requestAnimationFrame(tickProgress);
    typeAll().then(() => {
      const elapsed = performance.now() - start;
      const remaining = Math.max(0, MIN_DURATION - elapsed);
      setTimeout(finish, remaining + 150);
    });
  }
</script>
