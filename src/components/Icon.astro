---
// Единый набор line-иконок — без внешних библиотек, чтобы держать стиль
// линий (stroke-width, скругления) одинаковым по всему сайту.
interface Props {
  name:
    | "github"
    | "telegram"
    | "linkedin"
    | "mail"
    | "arrow-up-right"
    | "code"
    | "download"
    | "sparkle"
    | "home"
    | "user"
    | "folder";
  class?: string;
}

const { name, class: className = "" } = Astro.props;
---

{name === "github" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.3 6.84 9.65.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.36-3.37-1.36-.46-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.89 1.55 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.3 9.3 0 0 1 5 0c1.9-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.2C22 6.58 17.52 2 12 2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
  </svg>
)}

{name === "telegram" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="m3 11.5 16.7-6.9c.9-.35 1.7.28 1.4 1.34l-2.85 13.4c-.22 1-.86 1.24-1.75.77l-4.83-3.57-2.33 2.25c-.26.26-.48.48-.98.48l.35-4.95L17.9 8.3c.34-.3-.08-.47-.53-.17l-9.7 6.1-4.18-1.3c-.9-.29-.92-.9.2-1.43Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" stroke-linecap="round"/>
  </svg>
)}

{name === "linkedin" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.4"/>
    <path d="M7.5 10v6.5M7.5 7.6v.01M12 16.5V13c0-1.5.9-2.5 2.2-2.5 1.3 0 2.05.9 2.05 2.5v3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === "mail" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.4"/>
    <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === "arrow-up-right" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M7 17 17 7M9 7h8v8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === "code" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5.5l-3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === "download" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M12 4v11m0 0 4-4m-4 4-4-4M5 18.5h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === "sparkle" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M17.5 15.5 20 18M18 6l-2.5 2.5M8.5 15.5 6 18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
)}

{name === "home" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="m4 11 8-6.5L20 11M6 9.5V19a1 1 0 0 0 1 1h3v-5.5h4V20h3a1 1 0 0 0 1-1V9.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
)}

{name === "user" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <circle cx="12" cy="8.5" r="3.3" stroke="currentColor" stroke-width="1.4"/>
    <path d="M5.5 19c1.1-3 3.6-4.5 6.5-4.5s5.4 1.5 6.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
  </svg>
)}

{name === "folder" && (
  <svg viewBox="0 0 24 24" fill="none" class={className} aria-hidden="true">
    <path d="M4 6.5a1 1 0 0 1 1-1h4l1.8 2H19a1 1 0 0 1 1 1V17a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
  </svg>
)}
